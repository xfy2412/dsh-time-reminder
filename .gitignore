# Build output: `scripts/build.mjs` transpiles src/**.ts into lib/**.js, and the
# DSH loader loads lib/ as plain Node ESM. `pnpm pack`/`publish` rebuild it
# through the `prepack` script; never edit lib/ by hand.
lib/

node_modules/
*.log
