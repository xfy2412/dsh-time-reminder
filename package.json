{
  "name": "dsh-time-reminder",
  "version": "0.2.0",
  "description": "DSH 插件：可调精度的时钟上下文（off/cron/turn/fine）+ 会话内计时器（可见性可跨父子代理） + 跨重启可用倒计时器",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "clock",
    "cron",
    "timer",
    "reminder"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xfy2412/dsh-time-reminder.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client/index.js"
  },
  "files": [
    "lib/**/*.js",
    "client/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "node scripts/build.mjs && tsc --noEmit && node --test tests/*.test.ts",
    "prepack": "node scripts/build.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
